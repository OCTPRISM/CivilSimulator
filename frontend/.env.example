# CivilSimulator frontend — copy to frontend/.env.local
# Keep these aligned with uvicorn --port 8000 (R0-6).

# Used by next.config.js rewrites for /api/*
BACKEND_URL=http://localhost:8000

# Used by the browser for WebSocket (must reach the same backend).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: seed frontend/tsconfig.tsbuildinfo during ./scripts/bootstrap.sh
# (otherwise the script runs `npx tsc --incremental`).
# CIVSIM_TSBUILDINFO_URL=https://example.com/tsconfig.tsbuildinfo
