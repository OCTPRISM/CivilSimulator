# CivilSimulator backend — copy to backend/.env and adjust.
# Defaults match local Tech Preview: uvicorn on :8000.

ENV=development
# Production MUST set a unique secret (R0-3):
# ENV=production
# AUTH_SECRET=replace-with-a-long-random-string

AUTH_SECRET=civsim-dev-auth-secret-change-me

# Comma-separated browser origins (R0-4). Use * only for throwaway local probes.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limits per client IP / 60s (R0-5)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PLAY_PER_MINUTE=60
# Only enable when behind a trusted reverse proxy that sets X-Forwarded-For:
# TRUST_PROXY_HEADERS=true

# Invite / password (R1-5). Production ALWAYS requires invite (ENV=production).
# For local controlled preview you may also set:
INVITE_ONLY=false
# INVITE_CODE=your-preview-code
MIN_PASSWORD_LENGTH=8
# Production example:
# ENV=production
# AUTH_SECRET=replace-with-a-long-random-string
# INVITE_CODE=your-preview-code

# Redis multi-worker pub/sub is NOT wired (reserved for v0.4). Leave unset.
# REDIS_URL=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3.8:27b
OLLAMA_TEXT_FALLBACKS=gpt-oss:20b,qwen3.6:35b-a3b
OLLAMA_EMBED_MODEL=nomic-embed-text

QDRANT_ENABLED=true
QDRANT_PATH=data/runtime/qdrant
# QDRANT_URL=http://localhost:6333

DATA_DIR=data/runtime
SQLITE_PATH=data/runtime/civsim.db
