# CivilSimulator backend — copy to backend/.env and adjust.
# Defaults match local Tech Preview: uvicorn on :8000.

ENV=development
# Production MUST set a unique secret (R0-3):
# ENV=production
# AUTH_SECRET=replace-with-a-long-random-string

AUTH_SECRET=civsim-dev-auth-secret-change-me

# Comma-separated browser origins (R0-4). Use * only for throwaway local probes.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limits per client IP / 60s (R0-5)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PLAY_PER_MINUTE=60
# Only enable when behind a trusted reverse proxy that sets X-Forwarded-For:
# TRUST_PROXY_HEADERS=true

# LLM daily quotas (v0.5 P-7). UTC day; in-process (sticky worker recommended).
LLM_QUOTA_ENABLED=true
LLM_DAILY_QUOTA_PER_USER=200
LLM_DAILY_QUOTA_PER_SESSION=800

# Observability (v0.5 P-2)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Auth mail (v0.5 P-1). Default logs links to stdout (safe for local/invite).
PUBLIC_APP_URL=http://localhost:3000
MAIL_BACKEND=log
# MAIL_BACKEND=smtp
# MAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Scene art production multimodal path (v0.5 P-5)
SCENE_ART_ENABLED=true
SCENE_ART_RATE_LIMIT_PER_MINUTE=120

# Invite / password (R1-5). Production ALWAYS requires invite (ENV=production).
# For local controlled preview you may also set:
INVITE_ONLY=false
# INVITE_CODE=your-preview-code
MIN_PASSWORD_LENGTH=8
# Production example:
# ENV=production
# AUTH_SECRET=replace-with-a-long-random-string
# INVITE_CODE=your-preview-code

# Redis multi-worker room event bus (v0.4 MP-4). Optional.
# Leave unset for single-process fan-out (default Tech Preview).
# If set but Redis is down, the process still starts in single-process mode.
# REDIS_URL=redis://127.0.0.1:6379/0

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3.8:27b
OLLAMA_TEXT_FALLBACKS=gpt-oss:20b,qwen3.6:35b-a3b
OLLAMA_EMBED_MODEL=nomic-embed-text

QDRANT_ENABLED=true
QDRANT_PATH=data/runtime/qdrant
# QDRANT_URL=http://localhost:6333

DATA_DIR=data/runtime
SQLITE_PATH=data/runtime/civsim.db
